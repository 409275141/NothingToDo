page {
  background-color: #f5f5f5;
}

.container {
  padding: 20rpx;
}

.summary-card {
  background: linear-gradient(135deg, #07c160, #10b981);
  color: white;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
}

.summary-title {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 20rpx;
}

.summary-amount {
  font-size: 72rpx;
  font-weight: bold;
}

.summary-row {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(255,255,255,0.3);
}

.summary-item {
  text-align: center;
  flex: 1;
}

.summary-label {
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 10rpx;
}

.summary-value {
  font-size: 36rpx;
  font-weight: bold;
}

.quick-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.action-btn {
  flex: 1;
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.action-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.action-text {
  font-size: 26rpx;
  color: #333;
}

.credit-alert {
  background: #fff3cd;
  border-left: 6rpx solid #ffc107;
  padding: 30rpx;
  border-radius: 8rpx;
  margin-bottom: 30rpx;
}

.credit-alert-title {
  font-size: 28rpx;
  color: #856404;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.credit-alert-info {
  font-size: 24rpx;
  color: #856404;
}
