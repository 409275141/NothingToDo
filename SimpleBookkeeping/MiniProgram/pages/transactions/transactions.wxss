page {
  background-color: #f5f5f5;
}

.container {
  min-height: 100vh;
}

.tabs {
  display: flex;
  background: white;
  border-bottom: 1rpx solid #eee;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 30rpx;
  font-size: 28rpx;
  color: #666;
}

.tab.active {
  color: #07c160;
  border-bottom: 4rpx solid #07c160;
  font-weight: bold;
}

.content {
  padding: 20rpx;
}

.transaction-list {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.transaction-item {
  display: flex;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.transaction-left {
  flex: 1;
}

.transaction-category {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.transaction-date {
  font-size: 24rpx;
  color: #999;
}

.transaction-right {
  text-align: right;
}

.transaction-amount {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.transaction-amount.income {
  color: #07c160;
}

.transaction-amount.expense {
  color: #ff4d4f;
}

.transaction-desc {
  font-size: 24rpx;
  color: #999;
}

.empty-tip {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
  font-size: 28rpx;
}

.form-group {
  background: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: bold;
}

.type-selector {
  display: flex;
  gap: 20rpx;
}

.type-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  font-size: 28rpx;
  color: #666;
}

.type-btn.active.expense {
  background: #ff4d4f;
  color: white;
}

.type-btn.active.income {
  background: #07c160;
  color: white;
}

.form-input,
.form-picker {
  background: #f5f5f5;
  padding: 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.submit-btn {
  background: #07c160;
  color: white;
  border: none;
  border-radius: 16rpx;
  padding: 30rpx;
  font-size: 32rpx;
  margin-top: 40rpx;
}
